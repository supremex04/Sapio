# Copy to .env and adjust. .env is gitignored: never commit real keys.
# Secrets and per-machine overrides live here; providers, model routes and tunings live in settings.yaml.
# Any settings.yaml value can be overridden: VED_INFERENCE_ + path joined with "__".
# Reference: docs/guides/configuration.md

# Must match the backend's VED_INFERENCE_API_KEY
VED_INFERENCE_API_KEY=dev-internal-key

# --- Provider keys (named by providers.<name>.api_key_env in settings.yaml) ---
VED_INFERENCE_GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# --- Common overrides ---
# OCR engine for scanned pages/images: rapid | unlimited-remote | unlimited-local
VED_INFERENCE_OCR__ENGINE=rapid
# VED_INFERENCE_OCR__REMOTE__BASE_URL=http://gpu-host:10000/v1
# VED_INFERENCE_LLM__DEFAULT__PRIMARY__MODEL=gemini-3.8-flash
# VED_INFERENCE_PARSING__MAX_PAGES=200

# Use a different settings file (e.g. per environment)
# VED_INFERENCE_CONFIG=settings.prod.yaml
