# Copy to .env and adjust. .env is gitignored: never commit real keys.

# Must match the backend's VED_INFERENCE_API_KEY
VED_INFERENCE_API_KEY=dev-internal-key

# --- Text extraction ---
# OCR engine for scanned pages/images: rapid | unlimited-remote | unlimited-local
VED_INFERENCE_ENGINE=rapid
VED_INFERENCE_MAX_PAGES=200
VED_INFERENCE_PDF_RENDER_DPI=200
VED_INFERENCE_MAX_CONCURRENCY=1
# PDF pages with at least this many letters/digits in their text layer skip OCR
VED_INFERENCE_NATIVE_TEXT_MIN_CHARS=50

# --- LLM (study features) ---
VED_INFERENCE_LLM_PROVIDER=gemini
VED_INFERENCE_GEMINI_API_KEY=
VED_INFERENCE_GEMINI_MODEL=gemini-3.5-flash
VED_INFERENCE_GEMINI_FALLBACK_MODELS=["gemini-3.8-flash","gemini-3.5-flash-lite"]
VED_INFERENCE_GEMINI_THINKING_LEVEL=low
VED_INFERENCE_LLM_TIMEOUT_SECONDS=180
VED_INFERENCE_LLM_MAX_RETRIES=2

# --- unlimited-remote (SGLang / vLLM serving baidu/Unlimited-OCR) ---
# VED_INFERENCE_REMOTE_BASE_URL=http://gpu-host:10000/v1
# VED_INFERENCE_REMOTE_MODEL=Unlimited-OCR
# VED_INFERENCE_REMOTE_FLAVOR=sglang
# VED_INFERENCE_REMOTE_PAGES_PER_REQUEST=8

# --- unlimited-local (needs `pip install -e '.[local]'` and ~8 GB+ VRAM) ---
# VED_INFERENCE_LOCAL_MODEL_ID=baidu/Unlimited-OCR
# VED_INFERENCE_LOCAL_DEVICE=cuda
