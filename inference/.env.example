# Copy to .env and adjust. .env is gitignored: never commit real keys.
# Secrets and per-machine overrides live here; providers, model routes and tunings live in settings.yaml.
# Any settings.yaml value can be overridden: SAPIO_INFERENCE_ + path joined with "__".
# Reference: docs/guides/configuration.md

# Must match the backend's SAPIO_INFERENCE_API_KEY
SAPIO_INFERENCE_API_KEY=dev-internal-key

# --- Provider keys (named by providers.<name>.api_key_env in settings.yaml) ---
# Gemini: one key, or several separated by commas (key1,key2,...): one is used until it reaches its limit or is
# rejected, then the next.
SAPIO_INFERENCE_GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# --- Common overrides ---
# OCR engine for scanned pages/images: rapid | unlimited-remote | unlimited-local
SAPIO_INFERENCE_OCR__ENGINE=rapid
# SAPIO_INFERENCE_OCR__REMOTE__BASE_URL=http://gpu-host:10000/v1
# SAPIO_INFERENCE_LLM__DEFAULT__PRIMARY__MODEL=gemini-3.8-flash
# SAPIO_INFERENCE_PARSING__MAX_PAGES=200

# Use a different settings file (e.g. per environment)
# SAPIO_INFERENCE_CONFIG=settings.prod.yaml
